{
    "editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit",
        "source.fixAll.stylelint":  "explicit",
    },
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#edfbd5",
        "activityBar.background": "#edfbd5",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#50b4ee",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#15202b99",
        "statusBar.background": "#daf7a6",
        "statusBar.debuggingBackground": "#c3a6f7",
        "statusBar.debuggingForeground": "#15202b",
        "statusBar.foreground": "#15202b",
        "statusBarItem.hoverBackground": "#c7f377",
        "statusBarItem.remoteBackground": "#daf7a6",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#daf7a6",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#daf7a699",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "htmlhint.options": {
		"tagname-lowercase": true,
		"attr-lowercase": true,
		"attr-value-double-quotes": true,
		"doctype-first": false,
		"tag-pair": true,
		"spec-char-escape": true,
		"id-unique": true,
		"src-not-empty": true,
		"attr-no-duplication": true,
		"title-require": true,
		"empty-tag-not-self-closed": false
	},
    "peacock.color": "#DAF7A6",
    "css.validate": false,
    "less.validate": false,
    "scss.validate": false
}