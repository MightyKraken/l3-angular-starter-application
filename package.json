{
	"name": "l3-angular-starter-application",
	"version": "0.0.0",
	"packageManager": "npm@11.17.0",
	"scripts": {
		"start": "nx serve --port 4203",
		"start:dev": "nx serve --port 4203 --inspect",
		"build": "nx build",
		"build:prod": "nx build --configuration=production",
		"watch": "nx build --watch --configuration development",
		"test": "nx test",
		"test:ci": "nx test --run",
		"test:once": "nx test --watch=false",
		"analyze": "npm run build && node sonda.mjs",
		"lint": "eslint && stylelint \"{src,libs}/**/*.css\" && htmlhint \"{src,libs}/**/*.html\"",
		"lint:fix": "eslint --fix && stylelint \"{src,libs}/**/*.css\" --fix",
		"prepare": "husky install",
		"prettier": "prettier . --write",
		"generate-index": "bun vscode-generate-index-standalone src/",
		"docker-run": "docker run --detach --publish 80:80 --name l3-angular-starter-application l3-angular-starter-application",
		"docker-stop": "docker stop l3-angular-starter-application",
		"docker-build": "docker build -t l3-angular-starter-application .",
		"docker-restart": "npm run docker-build && npm run docker-run",
		"docker-push-latest": "docker push ghcr.io/sabikabtahee/angular-app:latest",
		"docker-image-remove": "docker rmi -f l3-angular-starter-application",
		"docker-build-latest": "docker build -t ghcr.io/sabikabtahee/angular-app:latest .",
		"docker-container-remove": "docker rm -f l3-angular-starter-application"
	},
	"private": true,
	"lint-staged": {
		"{src,libs}/**/*.{ts,js}": [
			"eslint --fix"
		],
		"{src,libs}/**/*.css": [
			"stylelint --fix"
		],
		"{src,libs}/**/*.{ts,js,css,html}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@angular/aria": "^21.0.0",
		"@angular/cdk": "^21.0.0",
		"@angular/common": "^21.0.0",
		"@angular/compiler": "^21.0.0",
		"@angular/core": "^21.0.0",
		"@angular/forms": "^21.0.0",
		"@angular/material": "^21.0.0",
		"@angular/platform-browser": "^21.0.0",
		"@angular/router": "^21.0.0",
		"@lucide/angular": "^1.16.0",
		"@tailwindcss/postcss": "^4.3.0",
		"postcss": "^8.5.15",
		"rxjs": "~7.8.0",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular-devkit/core": "^21.0.0",
		"@angular-devkit/schematics": "^21.0.0",
		"@angular-eslint/eslint-plugin": "^21.0.0",
		"@angular-eslint/eslint-plugin-template": "^21.0.0",
		"@angular-eslint/template-parser": "^21.0.0",
		"@angular/build": "^21.0.0",
		"@angular/cli": "^21.0.0",
		"@angular/compiler-cli": "^21.0.0",
		"@commitlint/cli": "21.1.0",
		"@commitlint/config-conventional": "21.1.0",
		"@eslint/js": "9.19.0",
		"@nx/angular": "23.1.0",
		"@nx/eslint-plugin": "^23.1.0",
		"@nx/workspace": "23.1.0",
		"@schematics/angular": "^21.0.0",
		"@stylistic/eslint-plugin": "^5.6.1",
		"daisyui": "^5.0.0",
		"eslint": "9.19.0",
		"eslint-config-prettier": "10.0.1",
		"eslint-plugin-prettier": "5.2.3",
		"eslint-plugin-simple-import-sort": "12.1.1",
		"eslint-plugin-unused-imports": "4.1.4",
		"htmlhint": "1.9.2",
		"husky": "8.0.0",
		"jsdom": "^29.1.1",
		"lint-staged": "17.0.5",
		"nx": "23.1.0",
		"prettier": "3.8.3",
		"sonda": "^0.13.1",
		"stylelint": "17.12.0",
		"stylelint-config-standard-scss": "17.0.0",
		"ts-node": "10.9.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "8.47.0",
		"vitest": "^4.1.9",
		"vscode-generate-index-standalone": "1.7.1"
	}
}
