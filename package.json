{
	"name": "l3-angular-starter-application",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"build:prod": "ng build --configuration=production",
		"watch": "ng build --watch --configuration development",
		"test": "ng test --browsers ChromeHeadless --watch=false",
		"docker-build": "docker build -t l3-angular-starter-application -f Dockerfile.prod .",
		"docker-run": "docker run --detach --publish 80:80 --name l3-angular-starter-application l3-angular-starter-application",
		"docker-stop": "docker stop l3-angular-starter-application",
		"docker-container-remove": "docker rm -f l3-angular-starter-application",
		"docker-image-remove": "docker rmi -f l3-angular-starter-application",
		"lint": "eslint && stylelint \"**/*.{css,scss}\" && htmlhint \"**/*.html\"",
		"lint:fix": "eslint --fix && stylelint \"**/*.{css,scss}\" --fix",
		"prettier": "npx prettier . --write",
		"prepare": "husky install"
	},
	"lint-staged": {
		"src/**/*.html": [
			"htmlhint"
		],
		"src/**/*.{css,scss}": [
			"stylelint"
		],
		"src/**/*.{ts,js}": [
			"eslint"
		],
		"src/**/*.{ts,js,css,scss,html}": [
			"prettier --write"
		]
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "^19.1.4",
		"@angular/common": "^19.1.4",
		"@angular/compiler": "^19.1.4",
		"@angular/core": "^19.1.4",
		"@angular/forms": "^19.1.4",
		"@angular/platform-browser": "^19.1.4",
		"@angular/platform-browser-dynamic": "^19.1.4",
		"@angular/router": "^19.1.4",
		"@tailwindcss/postcss": "^4.0.5",
		"postcss": "^8.5.1",
		"rxjs": "~7.8.0",
		"tailwindcss": "^4.0.5",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^19.1.5",
		"@angular/cli": "^19.1.5",
		"@angular/compiler-cli": "^19.1.4",
		"@eslint/js": "^9.19.0",
		"@types/jasmine": "~5.1.0",
		"eslint": "^9.19.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.1.4",
		"globals": "^15.14.0",
		"htmlhint": "^1.1.4",
		"husky": "^8.0.0",
		"jasmine-core": "~5.1.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"lint-staged": "^15.4.3",
		"prettier": "3.4.2",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"stylelint": "^16.14.1",
		"stylelint-config-standard-scss": "^14.0.0",
		"typescript": "~5.5.2",
		"typescript-eslint": "^8.22.0"
	}
}
