{
	"name": "l3-angular-starter-application",
	"version": "0.0.0",
	"scripts": {
		"test": "jest --config=jest.config.ts",
		"lint": "eslint && stylelint \"src/**/*.{css,scss}\" && htmlhint \"src/**/*.html\"",
		"start": "ng serve --port 4200",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test:ci": "jest --runInBand",
		"prepare": "husky install",
		"lint:fix": "eslint --fix && stylelint \"src/**/*.{css,scss}\" --fix",
		"prettier": "npx prettier . --write",
		"start:dev": "ng serve --port 4200 --inspect",
		"build:prod": "ng build --configuration=production",
		"test:watch": "jest --watch --config=jest.config.ts",
		"docker-run": "docker run --detach --publish 80:80 --name l3-angular-starter-application l3-angular-starter-application",
		"docker-stop": "docker stop l3-angular-starter-application",
		"docker-build": "docker build -t l3-angular-starter-application .",
		"docker-restart": "npm run docker-build && npm run docker-run",
		"generate-index": "npx vscode-generate-index-standalone src/",
		"docker-push-latest": "docker push ghcr.io/sabikabtahee/angular-app:latest",
		"docker-image-remove": "docker rmi -f l3-angular-starter-application",
		"docker-build-latest": "docker build -t ghcr.io/sabikabtahee/angular-app:latest .",
		"docker-container-remove": "docker rm -f l3-angular-starter-application"
	},
	"private": true,
	"lint-staged": {
		"src/**/*.{ts,js}": [
			"eslint --fix"
		],
		"src/**/*.{css,scss}": [
			"stylelint --fix"
		],
		"src/**/*.{ts,js,css,scss,html}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@angular/animations": "^20.1.3",
		"@angular/cdk": "^20.2.5",
		"@angular/common": "^20.1.3",
		"@angular/compiler": "^20.1.3",
		"@angular/core": "^20.1.3",
		"@angular/forms": "^20.1.3",
		"@angular/platform-browser": "^20.1.3",
		"@angular/platform-browser-dynamic": "^20.1.3",
		"@angular/router": "^20.1.3",
		"@primeuix/themes": "^1.2.3",
		"@tailwindcss/postcss": "^4.0.5",
		"postcss": "^8.5.1",
		"primeng": "^20.0.1",
		"rxjs": "~7.8.0",
		"tailwindcss": "^4.0.5",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular/build": "^20.1.2",
		"@angular/cli": "^20.1.2",
		"@angular/compiler-cli": "^20.1.3",
		"@commitlint/cli": "^19.7.1",
		"@commitlint/config-conventional": "^19.7.1",
		"@eslint/js": "^9.19.0",
		"@types/jest": "^29.5.14",
		"eslint": "^9.19.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.1.4",
		"globals": "^15.14.0",
		"htmlhint": "^1.1.4",
		"husky": "^8.0.0",
		"jest": "^30.0.5",
		"jest-preset-angular": "^15.0.0",
		"lint-staged": "^15.4.3",
		"postcss": "^8.5.3",
		"prettier": "3.4.2",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"stylelint": "^16.14.1",
		"stylelint-config-standard-scss": "^14.0.0",
		"ts-node": "^10.9.2",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.38.0",
		"vscode-generate-index-standalone": "^1.7.1"
	}
}
