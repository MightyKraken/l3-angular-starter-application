{
	"name": "l3-angular-starter-application",
	"version": "0.0.0",
	"scripts": {
		"test": "ng test",
		"test:once": "ng test --watch=false",
		"lint": "eslint && stylelint \"src/**/*.{css,scss}\" && htmlhint \"src/**/*.html\"",
		"start": "ng serve --port 4200",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test:ci": "ng test --run",
		"prepare": "husky install",
		"lint:fix": "eslint --fix && stylelint \"src/**/*.{css,scss}\" --fix",
		"prettier": "bun prettier . --write",
		"start:dev": "ng serve --port 4200 --inspect",
		"build:prod": "ng build --configuration=production",
		"docker-run": "docker run --detach --publish 80:80 --name l3-angular-starter-application l3-angular-starter-application",
		"docker-stop": "docker stop l3-angular-starter-application",
		"docker-build": "docker build -t l3-angular-starter-application .",
		"docker-restart": "npm run docker-build && npm run docker-run",
		"generate-index": "bun vscode-generate-index-standalone src/",
		"docker-push-latest": "docker push ghcr.io/sabikabtahee/angular-app:latest",
		"docker-image-remove": "docker rmi -f l3-angular-starter-application",
		"docker-build-latest": "docker build -t ghcr.io/sabikabtahee/angular-app:latest .",
		"docker-container-remove": "docker rm -f l3-angular-starter-application"
	},
	"private": true,
	"lint-staged": {
		"src/**/*.{ts,js}": [
			"eslint --fix"
		],
		"src/**/*.{css,scss}": [
			"stylelint --fix"
		],
		"src/**/*.{ts,js,css,scss,html}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@angular/animations": "21.0.0",
		"@angular/aria": "^21.0.0",
		"@angular/cdk": "21.0.0",
		"@angular/common": "21.0.0",
		"@angular/compiler": "21.0.0",
		"@angular/core": "21.0.0",
		"@angular/forms": "21.0.0",
		"@angular/material": "21.0.0",
		"@angular/platform-browser": "21.0.0",
		"@angular/platform-browser-dynamic": "21.0.0",
		"@angular/router": "21.0.0",
		"rxjs": "7.8.0",
		"tslib": "2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^21.0.0",
		"@angular/cli": "21.0.0",
		"@angular/compiler-cli": "21.0.0",
		"@commitlint/cli": "19.7.1",
		"@commitlint/config-conventional": "19.7.1",
		"@eslint/js": "9.19.0",
		"@tailwindcss/postcss": "4.1.14",
		"eslint": "9.19.0",
		"eslint-config-prettier": "10.0.1",
		"eslint-plugin-prettier": "5.2.3",
		"eslint-plugin-simple-import-sort": "12.1.1",
		"eslint-plugin-unused-imports": "4.1.4",
		"htmlhint": "1.1.4",
		"husky": "8.0.0",
		"jsdom": "^27.1.0",
		"lint-staged": "15.4.3",
		"postcss": "^8.5.3",
		"prettier": "3.4.2",
		"prettier-plugin-tailwindcss": "0.6.11",
		"stylelint": "16.14.1",
		"stylelint-config-standard-scss": "14.0.0",
		"tailwindcss": "4.1.14",
		"ts-node": "10.9.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "8.47.0",
		"vitest": "^4.0.8",
		"vscode-generate-index-standalone": "1.7.1"
	}
}
